# Copie para .env (ou exporte no shell) e ajuste. Nenhum valor real deve ser versionado.
SECRET_KEY=troque-por-uma-chave-aleatoria
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
CORS_ORIGINS=*
APP_ENV=development
# Habilita /admin/reset-db e /admin/query (enviar no cabeçalho X-Admin-Token). Vazio = desabilitado.
ADMIN_TOKEN=
