# Copie para .env (ou exporte no shell). Nenhum valor real deve ser versionado.
SECRET_KEY=troque-por-uma-chave-aleatoria
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=*
TOKEN_MAX_AGE_SECONDS=3600
# Sem SMTP_HOST as notificações são apenas registradas em log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
